{
  "name": "applypilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first job discovery, evaluation and application tracking built on JobSpy, Career Ops and Rolecraft.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "services/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test \"packages/*/test/*.test.ts\" \"adapters/*/test/*.test.ts\" \"services/*/test/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:python": "node scripts/run-jobspy-python.mjs -m unittest discover -s workers/jobspy/tests",
    "typecheck": "tsc --noEmit",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify": "npm run verify:sources && npm run typecheck && npm test && npm run test:python",
    "setup:jobspy": "node scripts/setup-jobspy.mjs",
    "discover": "node --experimental-strip-types services/discovery/src/cli.ts",
    "test:integration": "node --experimental-strip-types --test \"tests/integration/*.test.ts\"",
    "push": "node --experimental-strip-types services/discovery/src/push.ts",
    "career-ops": "node --experimental-strip-types services/discovery/src/career-ops.ts",
    "profile": "node --experimental-strip-types services/discovery/src/profile.ts",
    "evaluate": "node --experimental-strip-types services/evaluation/src/cli.ts",
    "prepare-application": "node --experimental-strip-types services/preparation/src/cli.ts",
    "schedule": "node --experimental-strip-types services/scheduler/src/cli.ts",
    "config:check": "node --experimental-strip-types packages/config/src/cli.ts",
    "verify:integration": "node scripts/verify-integration.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
