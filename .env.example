# ApplyPilot local configuration. Copy to .env (git-ignored) and edit.
# Every value is optional; the defaults below are used when a line is absent.
# Values set in your shell always win over this file.
# No API key is needed: evaluation uses your own `claude` CLI login.

# Folder holding the JobSpy, career-ops and KenilJobBoard checkouts.
APPLYPILOT_SOURCES_DIR=..
# Python with the pinned JobSpy installed (npm run setup:jobspy creates it).
APPLYPILOT_JOBSPY_PYTHON=runtime/.venv-jobspy/bin/python
# Career Ops data root: its CV, profile, portals, pipeline and reports.
APPLYPILOT_CAREER_OPS_DATA=runtime/career-ops-data
# Candidate profile (personal; never commit it).
APPLYPILOT_PROFILE=runtime/candidate-profile.json
# Structured logs.
APPLYPILOT_LOG_DIR=runtime/logs
# Claude Code CLI used for evaluation and drafts.
APPLYPILOT_CLAUDE_BIN=claude
# Local Rolecraft; only loopback addresses are accepted.
APPLYPILOT_ROLECRAFT_URL=http://127.0.0.1:5173
